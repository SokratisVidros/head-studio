{
  "name": "head-studio",
  "version": "0.1.0",
  "description": "Local visual studio, CLI and MCP server for auditing and fixing HTML <head> metadata: SERP snippets, Open Graph cards, favicons and JSON-LD.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "head-studio": "bin/cli.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "seo",
    "metadata",
    "open-graph",
    "favicon",
    "json-ld",
    "serp",
    "mcp",
    "nextjs",
    "astro"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:ui",
    "build:node": "tsup",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "citty": "^0.2.2",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "magic-string": "^1.4.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
